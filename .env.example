# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).
#
# Until these are set, the Influencers page runs on local demo data — it
# still works, "Add card" just won't persist across a page reload.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
